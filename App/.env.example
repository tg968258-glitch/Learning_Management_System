# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Learning Management System
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin Configuration
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password

# Gmail SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail address used to send LMS emails
SMTP_EMAIL=your_email@gmail.com

# Google App Password (NOT your normal Gmail password)
SMTP_PASSWORD=your_google_app_password_here

# Sender details
EMAIL_FROM_ADDRESS=your_email@gmail.com
EMAIL_FROM_NAME=LMS Platform

# Teacher Invitation Token Expiry (hours)
TEACHER_INVITE_EXPIRY_HOURS=48
